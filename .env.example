# Copy to .env and fill in values — do not commit .env
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=IdeaSearch
DB_USERNAME=
DB_PASSWORD=
# Optional Laravel-style URL; DB_HOST/DB_PORT/DB_DATABASE take precedence when set
DB_URL="sqlsrv:Server=127.0.0.1,1433;Database=IdeaSearch;Encrypt=no;TrustServerCertificate=yes;"
# ODBC driver name (see: Get-OdbcDriver)
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Shopee stealth (Camoufox)
# HEADLESS: auto | false | true | virtual
#   auto = Windows/macOS tampilkan jendela; Linux tanpa DISPLAY pakai Xvfb (virtual)
# OS: kosong = deteksi otomatis (windows/macos/linux)
SHOPEE_HEADLESS=auto
SHOPEE_OS=
SHOPEE_PROFILE_DIR=output/shopee-profile
SHOPEE_WARM_INTERVAL_MIN=15

# Alibaba USD → IDR fallback if live FX APIs are unreachable
USD_IDR_RATE=16250
