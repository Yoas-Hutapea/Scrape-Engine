# Copy to .env and fill in values — do not commit .env
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=IdeaSearch
DB_USERNAME=postgres
DB_PASSWORD=

# Shopee stealth (Camoufox) — headless=false lebih sulit dideteksi
SHOPEE_HEADLESS=false
SHOPEE_PROFILE_DIR=output/shopee-profile
SHOPEE_WARM_INTERVAL_MIN=15
